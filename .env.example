# ==========================================
# Frontend Vite - safe to expose in the browser
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_DISCORD_BRIDGE_URL=https://your-bot-api.example.com

# ==========================================
# Discord bot - server only, never use VITE_
# ==========================================
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://your-web-app.discloud.app
CORS_ORIGIN=https://your-web-app.discloud.app

DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_HP_GUILD_ID=1483260289632829493
DISCORD_MANAGEMENT_GUILD_ID=1497845087575740456

# Ticket channels by department
DISCORD_CHANNEL_ATENDIMENTO_GERAL_ID=your-channel-id
DISCORD_CHANNEL_SUPORTE_TECNICO_ID=your-channel-id
DISCORD_CHANNEL_FINANCEIRO_ID=your-channel-id
DISCORD_CHANNEL_RECURSOS_HUMANOS_ID=your-channel-id
DISCORD_CHANNEL_TICKET_PANEL_ID=your-abrir-ticket-channel-id

# Operational channels
DISCORD_CHANNEL_TRANSCRIPTS_ID=1502647502992838737
DISCORD_CHANNEL_HEADS_ID=your-heads-channel-id
DISCORD_CHANNEL_ALERTS_ID=your-alerts-channel-id
DISCORD_CHANNEL_LOGS_ID=your-logs-channel-id

# ==========================================
# Supabase bot backend - server only
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
